# Copy to .env and fill in, or export these as real environment variables.
# Never commit a populated .env file.

# --- Identity / auth (choose ONE of the two credential methods below) ---

# Option A: a previously issued refresh token (preferred; avoids storing a password)
CLM_REFRESH_TOKEN=

# Option B: username + password (exchanged for tokens via the password grant)
CLM_USERNAME=
CLM_PASSWORD=

# If neither is set, run `clm-mcp login` once to store credentials at
# ~/.config/clm-mcp/credentials.json (mode 0600). That file is then used
# automatically and none of the above needs to be set.
# CLM_CREDENTIALS_PATH=~/.config/clm-mcp/credentials.json

# --- Identity service ---
CLM_IDENTITY_TOKEN_URL=https://clm.selisestage.com/api/identity/v25/identity/token
CLM_IDENTITY_ORIGIN=https://clm.selisestage.com/

# --- Business API ---
# This server wraps four CLM services (shipment, construction, team, konshub),
# each with its own API gateway derived from CLM_API_ROOT_URL by default:
#   {CLM_API_ROOT_URL}/business-clm-{shipment,construction,team,konshub}
CLM_API_ROOT_URL=https://msblocks.selisestage.com/api

# DEPRECATED: shipment-only base URL override, kept for backwards
# compatibility with configs from before the other three services existed.
# Equivalent to CLM_API_BASE_URL_OVERRIDES='{"shipment": "..."}' below.
# CLM_API_BASE_URL=https://msblocks.selisestage.com/api/business-clm-shipment

# Per-service base URL overrides (JSON object, service slug -> full URL).
# Only needed to point one specific service at a non-default gateway.
# CLM_API_BASE_URL_OVERRIDES={"konshub": "https://example.test/api/business-clm-konshub"}

# --- Behavior ---
# Every *Command operation across all four services can execute (through
# clm_invoke, or a generated write tool if CLM_WRITE_TOOLS opts one in)
# whenever this is true. Set to "false" to run this server strictly
# read-only — no write executes at all, regardless of CLM_WRITE_TOOLS.
CLM_ENABLE_WRITES=true

# Which services get a NAMED tool per *Command operation (e.g.
# clm_shipment_command_discard_shipment) in addition to clm_invoke. Empty by
# default — clm_invoke already reaches every write with zero setup, and
# generating a named tool for all 181 write operations across all four
# services would add ~78,000 tokens of tool-definition context to every
# request. Comma-separated service slugs, or the literal "all":
#   CLM_WRITE_TOOLS=shipment
#   CLM_WRITE_TOOLS=shipment,konshub
#   CLM_WRITE_TOOLS=all
CLM_WRITE_TOOLS=

# Business API request timeouts, in seconds. The read timeout matters more than
# it looks: some operations are slow (e.g. clm_get_material_usage observed at
# 3-12s) — raise this rather than lowering it if you see timeouts.
CLM_API_CONNECT_TIMEOUT_SECONDS=10
CLM_API_READ_TIMEOUT_SECONDS=60

# Seconds of remaining token lifetime at which a proactive refresh is triggered.
CLM_TOKEN_REFRESH_SKEW_SECONDS=90

# Response shaping cap, in bytes, before a list response is truncated.
CLM_MAX_RESPONSE_BYTES=50000

# --- Logging ---
CLM_LOG_LEVEL=INFO

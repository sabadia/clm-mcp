# Copy to .env and fill in, or export these as real environment variables.
# Never commit a populated .env file.

# --- Identity / auth (choose ONE of the two credential methods below) ---

# Option A: a previously issued refresh token (preferred; avoids storing a password)
CLM_REFRESH_TOKEN=

# Option B: username + password (exchanged for tokens via the password grant)
CLM_USERNAME=
CLM_PASSWORD=

# If neither is set, run `clm-mcp login` once to store credentials at
# ~/.config/clm-mcp/credentials.json (mode 0600). That file is then used
# automatically and none of the above needs to be set.
# CLM_CREDENTIALS_PATH=~/.config/clm-mcp/credentials.json

# --- Identity service ---
CLM_IDENTITY_TOKEN_URL=https://clm.selisestage.com/api/identity/v25/identity/token
CLM_IDENTITY_ORIGIN=https://clm.selisestage.com/

# --- Business API ---
CLM_API_BASE_URL=https://msblocks.selisestage.com/api/business-clm-shipment

# --- Behavior ---
# Write tools (one per *Command operation — create/update/delete/discard/...)
# are registered by DEFAULT, alongside the read-only tools. Set to "false" to
# opt OUT and run this server strictly read-only instead.
CLM_ENABLE_WRITES=true

# Seconds of remaining token lifetime at which a proactive refresh is triggered.
CLM_TOKEN_REFRESH_SKEW_SECONDS=90

# Response shaping cap, in bytes, before a list response is truncated.
CLM_MAX_RESPONSE_BYTES=50000

# --- Logging ---
CLM_LOG_LEVEL=INFO
